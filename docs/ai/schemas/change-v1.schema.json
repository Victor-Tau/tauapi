{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "base_revision": {
      "type": "string"
    },
    "work_status": {
      "enum": [
        "planned",
        "in_progress",
        "blocked",
        "ready_for_ci",
        "verified",
        "completed"
      ]
    },
    "docs_impact": {
      "enum": [
        "affected",
        "none"
      ]
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "updated",
              "reviewed_unchanged",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "reason",
          "evidence"
        ]
      }
    },
    "validation": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "base_revision",
    "work_status",
    "docs_impact",
    "dispositions",
    "validation",
    "next_action"
  ]
}
